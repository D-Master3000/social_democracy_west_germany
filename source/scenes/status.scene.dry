title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

<span style="color: #c00000;">**SPD**</span> position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if in_social_liberal_coalition and spd_in_government: <span style="color: #c00000;">Social</span>-<span style="color: #FFCC00;">liberal</span> Coalition ?][? if in_grand_coalition and spd_in_government: <span style="color: #c00000;">Grand</span> <span style="color: #000000;">Coalition</span> ?][? if in_spd_majority and spd_in_government: <span style="color: #c00000;">**SPD**</span> majority ?][? if in_minority_government and spd_in_government: minority government ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): KPD coalition dissent: [+ kpd_coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [? if president == "Lübke": <span style="color: #000000;">Lübke</span> ?][? if president == "Heinemann": <span style="color: #C00000;">Heinemann</span> ?] [? if president_party == "CDU": (<span style="color: #000000;">**CDU**</span>) ?][? if president_party == "SPD": (<span style="color: #000000;">**SPD**</span>) ?])

Chancellor: [? if chancellor == "Kiesinger": <span style="color: #000000;">Kiesinger</span> ?][? if chancellor == "Brandt": <span style="color: #000000;">Brandt</span> ?] [? if chancellor_party == "CDU": (<span style="color: #000000;">**CDU**</span>) ?][? if chancellor_party == "SPD": (<span style="color: #000000;">**SPD**</span>= ?])

Reichstag composition:

# 1928: 30, 1930: 25, 1932: 22
{!<span class="tooltip-text" title="Social Democratic Party of Germany"><span style="color: #C00000;">SPD</span></span>!}: [+ spd_r +]%
# 1928: 15, 1930: 15, 1932: 
{!<span class="tooltip-text" title="Christian Democratic Union/Christian Social Union"><span style="color: #000000;">CDU + CSU</span></span>!}: [+ cdu_r +]%
# 1928: 9, 1930: 5
{!<span class="tooltip-text" title="Free Democratic Party"><span style="color: #FFCC00;">FDP</span></span>!}: [+ fdp_r +]%
# 1928: 3, 1930: 18
{!<span class="tooltip-text" title="National Democratic Party (Nazis)"><span style="color: #7A3C00;">NPD</span></span>!}: [+ npd_r +]%
# 1928: 9, 1930: 10
Others: [+ other_r +]%

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

= Economics

Inflation: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : Unemployment: [+ unemployed_2 +]% ?]

Economic growth: [+ economic_growth_2 +]%



